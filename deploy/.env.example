CONTENT_DEV_AUTH=true
CONTENT_PUBLIC_URL=http://localhost:3007
CONTENT_DATABASE_URL=postgres://content:content@content-db:5432/blog?sslmode=disable
SHORTENER_DEV_AUTH=true
SHORTENER_DATABASE_URL=postgres://content:content@content-db:5432/shortener?sslmode=disable
SHORTENER_REDIS_URL=redis://content-redis:6379/0
SHORTENER_PUBLIC_BASE=http://localhost:8094
SHORTENER_ALLOW_HOSTS=localhost,127.0.0.1
SHORTENER_CORS_ORIGIN=http://localhost:3007
SHORTENER_API_URL=http://shortener:8094

# Optional blog OIDC (pf-content-blog lib/oidc). Compose demo stays CONTENT_DEV_AUTH.
# When both OIDC_ISSUER and OIDC_CLIENT_ID are set, blog admin uses P01 instead of dev-login.
# OIDC_ISSUER=http://localhost:8080
# OIDC_INTERNAL_BASE=http://identity:8080
# OIDC_CLIENT_ID=content-blog
# OIDC_REDIRECT_URI=http://localhost:3007/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3007/logged-out
